<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="MAIN" Id="{d7652c90-63f4-4e4f-9c9a-cdf0391412f1}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	bCount : BOOL;
	iCounter : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bCount THEN
	iCounter := iCounter + 1;
	GVL_SAFETY.bRunStop := TRUE;
END_IF;
]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="2" Count="0" />
      <LineId Id="8" Count="0" />
      <LineId Id="11" Count="0" />
      <LineId Id="9" Count="1" />
    </LineIds>
  </POU>
</TcPlcObject>